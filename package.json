{
  "name": "is117-demo-days",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/generate-schedules.mjs --check && vitepress build docs",
    "docs:preview": "vitepress preview docs",
